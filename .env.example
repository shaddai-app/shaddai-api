# Copiar a .env con `npm run env:init` (genera secretos y contraseña de DB automáticamente).
# NUNCA commitear .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# SQL Server (login SQL dedicado; el adapter mssql de Prisma 7 no soporta auth integrada de Windows)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Shaddai
DB_USER=shaddai_app
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# Instancia usada por `npm run db:sql-login` (conexión con tu usuario Windows para crear el login)
SQL_ADMIN_SERVER=localhost,1433
# Base para `npm run test:int` (por defecto <DB_NAME>_test). Nunca apuntar a la base de desarrollo.
# DB_NAME_TEST=Shaddai_test

# Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
REFRESH_REMEMBER_TTL_DAYS=30
TOTP_ENC_KEY=
RATE_LIMIT_ENABLED=true
# memory (una instancia) | db (contadores compartidos en SQL Server). Vacío: db en producción, memory en el resto.
RATE_LIMIT_STORE=

# Seed
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_FIRST_NAME=Super
SEED_SUPERADMIN_LAST_NAME=Admin
# Crea "Iglesia Demo" (cuenta 1) con usuarios demo-admin/pastor/tesorero/lider@shaddai.local. En producción
# también: tiene que ser lo primero que se crea, para que quede con id 1. La API usa SEED_DEMO_PASSWORD
# para restablecer la demo desde el panel de plataforma (12+ caracteres).
SEED_DEMO=false
SEED_DEMO_PASSWORD=

# Archivos: local (carpeta) | s3 (bucket compatible con S3: Cloudflare R2 en producción)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Solo con STORAGE_DRIVER=s3. R2: endpoint https://<id de cuenta>.r2.cloudflarestorage.com, región auto.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mail: console (dev: el mail se imprime en el log de la API) | smtp (obligatorio en producción) | memory (tests)
MAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Shaddai <no-reply@shaddai.local>"
# Contacto de soporte que ven las iglesias (mail de baja de cuenta)
SUPPORT_EMAIL=soporte@shaddai.local

# Aviso diario de vencidos (préstamos, consolidación, células sin reportar), a partir de esta hora local
JOBS_ENABLED=true
DAILY_NOTICES_HOUR=8

# Sentry (errores no previstos, sin datos personales). Vacío = no se envía nada.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Cloudflare Turnstile (formulario público "Soy nuevo"). Vacío en desarrollo = sin verificación.
# Claves de prueba de Cloudflare: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# Geocodificación (buscar coordenadas de una dirección): none | locationiq | geoapify
GEOCODING_PROVIDER=none
GEOCODING_API_KEY=
GEOCODING_COUNTRY=ar

# Cobro del servicio: fake (desarrollo, sin dinero real) | mercadopago | none (pagos a mano).
# Vacío: fake en desarrollo, none en producción.
# En producción: mercadopago (o none). Las credenciales salen del panel de Mercado Pago
# (Tus integraciones → credenciales de producción; el secreto de webhooks en Webhooks).
BILLING_PROVIDER=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
BILLING_GRACE_DAYS=5
