# Copiar a .env con `npm run env:init` (genera secretos y contraseña de DB automáticamente).
# NUNCA commitear .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# SQL Server (login SQL dedicado; el adapter mssql de Prisma 7 no soporta auth integrada de Windows)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Shaddai
DB_USER=shaddai_app
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# Instancia usada por `npm run db:sql-login` (conexión con tu usuario Windows para crear el login)
SQL_ADMIN_SERVER=localhost,1433
# Base para `npm run test:int` (por defecto <DB_NAME>_test). Nunca apuntar a la base de desarrollo.
# DB_NAME_TEST=Shaddai_test

# Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
REFRESH_REMEMBER_TTL_DAYS=30
TOTP_ENC_KEY=
RATE_LIMIT_ENABLED=true

# Seed
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_FIRST_NAME=Super
SEED_SUPERADMIN_LAST_NAME=Admin
SEED_DEMO=false

# Archivos
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Mail: console (dev: el mail se imprime en el log de la API) | smtp | memory (tests)
MAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Shaddai <no-reply@shaddai.local>"
