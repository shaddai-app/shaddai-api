// Finanzas: libro de caja por cuenta (cajas, categorías, movimientos con comprobantes).
// Nunca se borra un movimiento: se anula con motivo. Los montos son siempre positivos; el signo lo da
// el tipo (income/transfer_in suman, expense/transfer_out restan).

model FinanceAccount {
  id                Int                    @id @default(autoincrement())
  accountId         Int
  account           Account                @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campusId          Int?
  campus            Campus?                @relation(fields: [campusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name              String                 @db.NVarChar(100)
  type              String                 @db.VarChar(6) // cash|bank|wallet
  currency          String                 @db.Char(3) // cada caja tiene su moneda (ARS, USD…); no se convierte
  openingBalance    Decimal                @default(0) @db.Decimal(18, 2)
  openingDate       DateTime               @db.Date
  responsibleUserId Int?
  responsible       User?                  @relation(fields: [responsibleUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  movements         FinanceMovement[]
  offeringCounts    OfferingCount[]
  periodBalances    FinancePeriodBalance[]

  @@index([accountId])
}

model FinanceCategory {
  id         Int                 @id @default(autoincrement())
  accountId  Int
  account    Account             @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind       String              @db.VarChar(7) // income|expense
  systemKey  String?             @db.VarChar(40) // tithe|offering|… (nombre traducido si name es null)
  name       String?             @db.NVarChar(100)
  sortOrder  Int
  isActive   Boolean             @default(true)
  movements  FinanceMovement[]
  countLines OfferingCountLine[]

  @@index([accountId, kind])
}

model FinanceMovement {
  id               Int                  @id @default(autoincrement())
  accountId        Int
  account          Account              @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  financeAccountId Int? // null solo en pendientes (tesorería elige la caja al confirmar) y rechazados
  financeAccount   FinanceAccount?      @relation(fields: [financeAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId       Int? // null en transferencias
  category         FinanceCategory?     @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind             String               @db.VarChar(12) // income|expense|transfer_in|transfer_out
  date             DateTime             @db.Date
  amount           Decimal              @db.Decimal(18, 2) // siempre positivo
  description      String?              @db.NVarChar(300)
  personId         Int? // aportante (diezmo nominal): solo visible con finanzas.diezmos_nominales
  person           Person?              @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isAnonymous      Boolean              @default(false)
  paymentMethod    String?              @db.VarChar(10) // cash|transfer|card|wallet|other
  reference        String?              @db.NVarChar(100)
  // pending (ofrenda de célula sin confirmar) | confirmed | voided | rejected (pendiente rechazado)
  status           String               @default("confirmed") @db.VarChar(10)
  transferPairId   Int? // el otro movimiento de la transferencia (sin FK: evita ciclos en SQL Server)
  cellReportId     Int? // ofrenda de un reporte de célula
  cellReport       CellReport?          @relation(fields: [cellReportId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offeringCountId  Int? // generado al confirmar un arqueo
  offeringCount    OfferingCount?       @relation(fields: [offeringCountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  confirmedAt      DateTime? // pendiente confirmado por tesorería
  confirmedById    Int?
  voidedAt         DateTime? // anulado o rechazado (voidReason es el motivo en los dos casos)
  voidedById       Int?
  voidReason       String?              @db.NVarChar(300)
  createdById      Int
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  attachments      MovementAttachment[]

  @@index([accountId, date])
  @@index([accountId, financeAccountId, date])
  @@index([accountId, categoryId, date])
  @@index([accountId, personId])
  @@index([accountId, status])
  @@index([transferPairId])
  @@index([cellReportId])
  @@index([offeringCountId])
}

// Comprobantes (foto o PDF) de un movimiento.
model MovementAttachment {
  movementId Int
  movement   FinanceMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  fileId     Int
  file       FileObject      @relation(fields: [fileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt  DateTime        @default(now())

  @@id([movementId, fileId])
  @@index([fileId])
}

// Arqueo de culto: dos personas cuentan la ofrenda y firman. Mientras es borrador se corrige; al
// confirmarlo se generan los ingresos en la caja (uno por categoría y medio de pago, y uno por cada
// sobre nominal). Confirmado no se edita: se anula entero (anula sus movimientos) y se vuelve a cargar.
model OfferingCount {
  id               Int                 @id @default(autoincrement())
  accountId        Int
  account          Account             @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  financeAccountId Int
  financeAccount   FinanceAccount      @relation(fields: [financeAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date             DateTime            @db.Date
  title            String?             @db.NVarChar(100) // "Culto domingo 10 h"
  counter1PersonId Int
  counter1         Person              @relation("OfferingCounter1", fields: [counter1PersonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  counter2PersonId Int
  counter2         Person              @relation("OfferingCounter2", fields: [counter2PersonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status           String              @default("draft") @db.VarChar(10) // draft|confirmed|voided
  notes            String?             @db.NVarChar(500)
  createdById      Int
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  confirmedAt      DateTime?
  confirmedById    Int?
  voidedAt         DateTime?
  voidedById       Int?
  voidReason       String?             @db.NVarChar(300)
  lines            OfferingCountLine[]
  movements        FinanceMovement[]

  @@index([accountId, date])
  @@index([accountId, status])
}

// Renglón del arqueo: billetes de una denominación (denominación × cantidad), un total por medio de
// pago o un sobre de diezmo con nombre (personId).
model OfferingCountLine {
  id            Int             @id @default(autoincrement())
  countId       Int
  count         OfferingCount   @relation(fields: [countId], references: [id], onDelete: Cascade)
  categoryId    Int
  category      FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentMethod String          @db.VarChar(10) // cash|transfer|card|wallet|other
  denomination  Decimal?        @db.Decimal(10, 2)
  quantity      Int?
  amount        Decimal         @db.Decimal(18, 2)
  personId      Int? // sobre nominal: solo visible con finanzas.diezmos_nominales
  person        Person?         @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sortOrder     Int

  @@index([countId])
  @@index([personId])
}

// Cierre mensual: un mes cerrado no acepta altas, ediciones ni anulaciones con fecha en él. Al cerrar
// se guarda la foto de los saldos de cada caja. Se cierra en orden y solo se reabre el último cerrado
// (con permiso y motivo; queda auditado).
model FinancePeriod {
  id           Int                    @id @default(autoincrement())
  accountId    Int
  account      Account                @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  year         Int                    @db.SmallInt
  month        Int                    @db.TinyInt
  status       String                 @default("open") @db.VarChar(6) // open|closed
  closedAt     DateTime?
  closedById   Int?
  notes        String?                @db.NVarChar(500)
  reopenedAt   DateTime? // última reapertura
  reopenedById Int?
  reopenReason String?                @db.NVarChar(300)
  balances     FinancePeriodBalance[]

  @@unique([accountId, year, month])
}

// Saldos de una caja en un mes cerrado (se borran al reabrir y se recalculan al volver a cerrar).
model FinancePeriodBalance {
  periodId         Int
  period           FinancePeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  financeAccountId Int
  financeAccount   FinanceAccount @relation(fields: [financeAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opening          Decimal        @db.Decimal(18, 2)
  income           Decimal        @db.Decimal(18, 2)
  expense          Decimal        @db.Decimal(18, 2)
  transfersIn      Decimal        @db.Decimal(18, 2)
  transfersOut     Decimal        @db.Decimal(18, 2)
  closing          Decimal        @db.Decimal(18, 2)

  @@id([periodId, financeAccountId])
  @@index([financeAccountId])
}
