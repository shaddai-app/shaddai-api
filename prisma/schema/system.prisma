// Archivos subidos por la cuenta (logo, comprobantes, fotos). El binario vive en el StorageProvider.
model FileObject {
  id           Int                  @id @default(autoincrement())
  accountId    Int
  account      Account              @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  storageKey   String               @unique @db.VarChar(300)
  originalName String               @db.NVarChar(250)
  mimeType     String               @db.VarChar(100)
  sizeBytes    Int
  purpose      String               @db.VarChar(30) // logo|receipt|photo|cell_report|inventory
  uploadedById Int
  createdAt    DateTime             @default(now())
  deletedAt    DateTime?
  movements    MovementAttachment[]

  @@index([accountId, purpose])
}

// Sin FKs a propósito: la auditoría sobrevive a borrados de usuarios/cuentas.
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  accountId      Int?
  userId         Int?
  impersonatorId Int?
  action         String   @db.VarChar(60)
  entity         String?  @db.VarChar(40)
  entityId       String?  @db.VarChar(40)
  before         String?  @db.NVarChar(Max)
  after          String?  @db.NVarChar(Max)
  ip             String?  @db.VarChar(45)
  userAgent      String?  @db.NVarChar(300)
  requestId      String?  @db.VarChar(36)
  createdAt      DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([accountId, entity, entityId])
}

// Avisos para un usuario (centro de notificaciones). El texto lo arma el front con su i18n a partir
// de `type` y `params` (JSON); el mail, si corresponde según sus preferencias, lo arma la API.
model Notification {
  id        Int       @id @default(autoincrement())
  accountId Int
  account   Account   @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type      String    @db.VarChar(40)
  params    String?   @db.NVarChar(Max)
  link      String?   @db.VarChar(300)
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, userId, readAt])
  @@index([userId, createdAt])
}
