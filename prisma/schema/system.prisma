// Archivos subidos por la cuenta (logo, comprobantes, fotos). El binario vive en el StorageProvider.
model FileObject {
  id           Int                  @id @default(autoincrement())
  accountId    Int
  account      Account              @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  storageKey   String               @unique @db.VarChar(300)
  originalName String               @db.NVarChar(250)
  mimeType     String               @db.VarChar(100)
  sizeBytes    Int
  purpose      String               @db.VarChar(30) // logo|receipt|photo|cell_report|inventory
  uploadedById Int
  createdAt    DateTime             @default(now())
  deletedAt    DateTime?
  movements    MovementAttachment[]

  @@index([accountId, purpose])
}

// Sin FKs a propósito: la auditoría sobrevive a borrados de usuarios/cuentas.
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  accountId      Int?
  userId         Int?
  impersonatorId Int?
  action         String   @db.VarChar(60)
  entity         String?  @db.VarChar(40)
  entityId       String?  @db.VarChar(40)
  before         String?  @db.NVarChar(Max)
  after          String?  @db.NVarChar(Max)
  ip             String?  @db.VarChar(45)
  userAgent      String?  @db.NVarChar(300)
  requestId      String?  @db.VarChar(36)
  createdAt      DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([accountId, entity, entityId])
}

// Avisos para un usuario (centro de notificaciones). El texto lo arma el front con su i18n a partir
// de `type` y `params` (JSON); el mail, si corresponde según sus preferencias, lo arma la API.
model Notification {
  id        Int       @id @default(autoincrement())
  accountId Int
  account   Account   @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type      String    @db.VarChar(40)
  params    String?   @db.NVarChar(Max)
  link      String?   @db.VarChar(300)
  readAt    DateTime?
  emailedAt DateTime?
  // false: el usuario apagó este aviso en la app; queda solo como registro del mail (y para no
  // repetirlo).
  inApp     Boolean   @default(true)
  // Avisos del proceso diario: el mismo hecho (ej. un préstamo vencido) se avisa una sola vez.
  dedupeKey String?   @db.VarChar(150)
  createdAt DateTime  @default(now())

  @@index([accountId, userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, dedupeKey])
}

// Traba de los procesos diarios: una fila por cuenta, proceso y día local. Si dos instancias de la
// API intentan correrlo, la segunda choca con la clave única y no hace nada.
model DailyJobRun {
  id         Int       @id @default(autoincrement())
  accountId  Int
  account    Account   @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job        String    @db.VarChar(40)
  runDate    DateTime  @db.Date
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  notices    Int?
  error      String?   @db.NVarChar(1000)

  @@unique([accountId, job, runDate])
}

// Contadores del rate limit compartidos entre instancias de la API (sin cuenta: se cuentan por IP).
// Las filas vencidas se reinician en el próximo golpe y el programador borra las viejas.
model RateLimitHit {
  key     String   @id @db.VarChar(200)
  hits    Int
  resetAt DateTime

  @@index([resetAt])
}
