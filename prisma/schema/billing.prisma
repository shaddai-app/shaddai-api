// Cobro del servicio a cada iglesia. Una suscripción es el débito automático mensual en el proveedor
// (Mercado Pago, o "fake" en desarrollo y tests); cada cobro aprobado es una Invoice que extiende
// Account.paidUntil. Un pago registrado a mano por la plataforma es una Invoice con provider "manual".
model Subscription {
  id            Int       @id @default(autoincrement())
  accountId     Int
  account       Account   @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  planId        Int
  plan          Plan      @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider      String    @db.VarChar(20) // mercadopago|fake
  providerRef   String    @db.VarChar(100) // id de la suscripción en el proveedor
  // Referencia propia que viaja al proveedor (external_reference): identifica cuenta y suscripción.
  externalRef   String    @unique @db.VarChar(64)
  status        String    @default("pending") @db.VarChar(15) // pending|authorized|paused|cancelled
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @db.Char(3)
  payerEmail    String    @db.NVarChar(150)
  checkoutUrl   String?   @db.NVarChar(500)
  nextPaymentAt DateTime?
  createdById   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cancelledAt   DateTime?
  invoices      Invoice[]

  @@unique([provider, providerRef])
  @@index([accountId, status])
}

model Invoice {
  id             Int           @id @default(autoincrement())
  accountId      Int
  account        Account       @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptionId Int?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider       String        @db.VarChar(20) // mercadopago|fake|manual
  providerRef    String        @db.VarChar(100) // id del cobro en el proveedor (manual: generado)
  status         String        @db.VarChar(15) // pending|approved|rejected|refunded
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @db.Char(3)
  // Período que cubre (solo los aprobados extienden paidUntil).
  periodStart    DateTime?
  periodEnd      DateTime?
  paidAt         DateTime?
  note           String?       @db.NVarChar(300)
  createdById    Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, providerRef])
  @@index([accountId, createdAt])
}
